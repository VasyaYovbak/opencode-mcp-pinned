{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "company-tools": {
        "type": "remote",
        "url": "https://mcp.example.com/mcp",
        "codemode": true
      }
    }
  },
  "plugins": [
    {
      "package": "github:VasyaYovbak/opencode-mcp-pinned#main",
      "options": {
        "servers": {
          "company-tools": { "pinned": true }
        },
        "waitMs": 10000
      }
    }
  ]
}
